# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Training image: runs the full DVC pipeline (fetch -> validate -> ... ->
# evaluate). Suitable as a Kubernetes Job / Argo Workflows step for
# scheduled or drift-triggered retraining.
#
#   docker build -f docker/Dockerfile.train -t ev-battery-train .
#   docker run --rm -v "$PWD/models:/app/models" -v "$PWD/reports:/app/reports" ev-battery-train
# ---------------------------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements/train.txt requirements/train.txt
RUN pip install --no-cache-dir -r requirements/train.txt

COPY params.yaml dvc.yaml dvc.lock ./
COPY .dvc/config .dvc/config
COPY data/raw/ev_battery_data.csv.dvc data/raw/ev_battery_data.csv.dvc
COPY src/ src/

# No .git inside the image: let DVC run without SCM integration.
RUN dvc config core.no_scm true && mkdir -p mlflow

CMD ["sh", "-c", "python -m src.data.fetch_data && dvc repro"]
