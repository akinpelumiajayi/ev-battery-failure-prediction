# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# Serving image: FastAPI inference server with the model baked in.
#
# The trained artifacts are copied in at build time, so each image tag is an
# immutable, self-contained (code + model) unit: rollbacks are just "deploy
# the previous tag", and pods have no runtime dependency on MLflow or DVC.
# ---------------------------------------------------------------------------
FROM python:3.12-slim AS builder
WORKDIR /build
COPY requirements/serve.txt .
RUN pip install --no-cache-dir --prefix=/install -r serve.txt

FROM python:3.12-slim
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.title="ev-battery-failure-api" \
      org.opencontainers.image.description="EV battery failure prediction API (FastAPI + scikit-learn)" \
      org.opencontainers.image.source="https://github.com/akinpelumiajayi/ev-battery-failure-prediction" \
      org.opencontainers.image.revision="${GIT_SHA}" \
      org.opencontainers.image.licenses="MIT"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MODEL_VERSION=${GIT_SHA}

# libgomp: OpenMP runtime required by LightGBM / XGBoost wheels
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home --shell /usr/sbin/nologin appuser \
    # Writable mount point for a local inference log (docker-compose). In
    # Kubernetes the root FS is read-only and the log goes to object storage.
    && mkdir -p /var/lib/ev-battery/inference-logs \
    && chown -R 10001:10001 /var/lib/ev-battery

COPY --from=builder /install /usr/local

WORKDIR /app
COPY src/__init__.py src/
COPY src/serving/ src/serving/
COPY artifacts/preprocessor.joblib artifacts/feature_metadata.joblib artifacts/
COPY models/model.joblib models/model_metadata.json models/test_metrics.json models/

USER 10001
EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health', timeout=2)"

# One worker per container: Prometheus client metrics are per-process, and
# horizontal scaling is the HPA's job, not uvicorn's.
CMD ["uvicorn", "src.serving.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
